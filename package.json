{
  "name": "@deepwhale-cn/dsh-badge",
  "version": "0.1.1",
  "description": "深鲸桌面署名徽章 skill：给用深鲸桌面产出的文档/README/PR 加「powered by dwh」徽章（默认自动署名）",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0",
    "node": ">=18"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepwhale",
    "badge",
    "attribution"
  ],
  "license": "MIT",
  "author": "温州深鲸智能科技有限公司 <contact@deepwhale.org.cn>",
  "homepage": "https://deepwhale.org.cn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feely0208/dsh-badge.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill": "*"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "深鲸徽章",
    "description": "给用深鲸桌面产出的文档 / PR 加「powered by dwh」署名徽章（胶囊圆角，121×20）。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
